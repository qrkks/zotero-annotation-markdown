{
  "name": "zotero-annotation-markdown",
  "version": "0.16.4",
  "description": "Render Zotero annotation comments with Markdown, LaTeX math, and experimental SVG and Mermaid diagrams, preserving editable source.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "site:install": "pnpm --dir site install --ignore-workspace --frozen-lockfile",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm run typecheck:scripts && pnpm run typecheck:tests",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "docs:check": "node scripts/check-docs.mts",
    "build": "node scripts/build.mts",
    "package": "pnpm run build && node scripts/package.mts",
    "release:verify": "node scripts/verify-release.mts",
    "verify": "pnpm test && pnpm run typecheck && pnpm run docs:check && pnpm run build && pnpm run package",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "dompurify": "^3.4.17",
    "katex": "^0.18.2",
    "markdown-it": "^14.3.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "pele": "1.7.0"
  },
  "devDependencies": {
    "@fluent/bundle": "0.19.1",
    "@types/css-tree": "3.2.0",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.19.2",
    "@zip.js/zip.js": "^2.8.34",
    "esbuild": "^0.28.1",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vitest": "^4.1.10",
    "zotero-types": "^4.1.3"
  }
}
