{
  "name": "zotero-annotation-markdown",
  "version": "0.12.0",
  "description": "Render Zotero reader annotation comments as Markdown with LaTeX math.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "build": "node scripts/build.mjs",
    "package": "pnpm run build && node scripts/package.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "verify": "pnpm test && pnpm run typecheck && pnpm run docs:check && pnpm run build && pnpm run package"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.18.2",
    "markdown-it": "^14.3.1",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@zip.js/zip.js": "^2.8.34",
    "esbuild": "^0.28.1",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vitest": "^4.1.10",
    "zotero-types": "^4.1.3"
  }
}
